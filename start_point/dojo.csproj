<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Taken from the .NET that is installed, rather than written out, so
         this keeps naming the right one as .NET is updated. Microsoft.NET.Sdk
         sets NETCoreSdkVersion before this group is read. -->
    <TargetFramework>net$([System.Version]::Parse($(NETCoreSdkVersion)).Major).0</TargetFramework>

    <!-- Both are needed. Without them an MSTest project is a library that a
         separate runner loads: running the assembly does nothing and exits 0,
         and compiling against it fails with
           error CS5001: Program does not contain a static 'Main' method
         With them it is a program that runs its own tests, which is what the
         fast path in cyber-dojo.sh starts directly. -->
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>none</AnalysisLevel>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <!-- MSTest has no mocking of its own, so the mocks in HikerTest.cs come
         from these, the same two the other csharp start-points use. -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

</Project>
